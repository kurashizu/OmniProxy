{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniProxy",
  "version": "1.0.6",
  "identifier": "xyz.022025.omniproxy.gui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OmniProxy",
        "width": 600,
        "height": 400,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://api.ipify.org https://api64.ipify.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "kurashizu",
    "resources": [
      "resources/proxy.exe",
      "resources/client.exe",
      "resources/wintun.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "OmniProxy Desktop Client",
    "longDescription": "Tauri 2 GUI for OmniProxy: SOCKS5 + WebSocket tunnel.",
    "windows": {
      "wix": {
        "language": "en-US",
        "upgradeCode": "138eeafd-22da-5f30-b3c4-78795a9b4846"
      }
    }
  }
}
