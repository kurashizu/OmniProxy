{
  "name": "omniproxy-gui",
  "version": "1.0.6-rc.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:host": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "serve": "serve out -l 3000",
    "serve:host": "serve out -l tcp://0.0.0.0:3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "copy:binaries": "bash scripts/copy-binaries.sh",
    "tauri:build": "pnpm tauri build && pnpm copy:binaries",
    "tauri:build:windows": "pnpm tauri build --target x86_64-pc-windows-msvc && pnpm copy:binaries -- --target x86_64-pc-windows-msvc",
    "tauri:build:windows-gnu": "pnpm tauri build --target x86_64-pc-windows-gnu && pnpm copy:binaries -- --target x86_64-pc-windows-gnu",
    "tauri:build:host": "pnpm tauri build --target x86_64-unknown-linux-gnu && pnpm copy:binaries -- --target x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "clsx": "^2.1.1",
    "next": "15.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-virtuoso": "^4.12.0",
    "uplot": "^1.6.31",
    "uplot-react": "^1.2.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0-beta.7",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "postcss": "^8.4.49",
    "serve": "^14.2.6",
    "tailwindcss": "^4.0.0-beta.7",
    "typescript": "^5.7.2"
  }
}
